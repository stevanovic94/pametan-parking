// fajl opisuje strukturu BP 

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role{
  USER
  OPERATOR
  ADMIN
}

model User{
  id           String   @id @default(uuid())    // @id - prim kljuc, uuid() - generise kompleksan ID
  firstName    String   @db.VarChar(50)
  lastName     String   @db.VarChar(50)
  email        String   @unique @db.VarChar(255)  // @unique - dva korisnika ne mogu imati isti email
  passwordHash String   @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}