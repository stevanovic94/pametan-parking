// fajl opisuje strukturu BP 

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  OPERATOR
  ADMIN
}

// @id - prim kljuc, uuid() - generise kompleksan ID
// @unique - dva korisnika ne mogu imati isti email
model User {
  id           String   @id @default(uuid())
  firstName    String   @db.VarChar(50)
  lastName     String   @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions            Session[]
  revokedAccessTokens RevokedAccessToken[]
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @db.VarChar(255)
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RevokedAccessToken {
  id        String   @id @default(uuid())
  jti       String   @unique @db.VarChar(64)
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

enum ParkingSpaceOccupancy {
  UNKNOWN
  FREE
  OCCUPIED
}

model ParkingLot {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(100)
  address     String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  spaces ParkingSpace[]

  @@index([isActive])
}

model ParkingSpace {
  id              String                @id @default(uuid())
  parkingLotId    String
  code            String                @db.VarChar(20)
  occupancyStatus ParkingSpaceOccupancy @default(UNKNOWN) // fizicka zauzetost
  isActive        Boolean               @default(true) // administrativno polje
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  parkingLot ParkingLot @relation(fields: [parkingLotId], references: [id], onDelete: Restrict)

  @@unique([parkingLotId, code])
  @@index([parkingLotId])
  @@index([parkingLotId, isActive, occupancyStatus])
}
